# ================================================
# NirogNet Backend — Environment Variables
# ================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ================================================

# ---- Database ----
# PostgreSQL connection string (e.g. Supabase, Railway, local Postgres)
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname?sslmode=require

# ---- Flask Security ----
# Random secret string used by Flask for session signing
SECRET_KEY=your-random-flask-secret-key

# ---- JWT ----
# Secret key used to sign JWT access tokens
JWT_SECRET_KEY=your-random-jwt-secret-key

# ---- Google Gemini AI ----
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ---- Razorpay Payments ----
# Obtain from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

